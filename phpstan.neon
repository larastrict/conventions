includes:
    - extension.neon

parameters:
    bootstrapFiles:
        - vendor/symplify/easy-coding-standard/vendor/autoload.php

    # Rule fixtures deliberately contain invalid PHP types and convention violations.
    # Keep symbols available while checking their diagnostics through RuleTestCase.
    scanDirectories:
        - tests/PHPStan/Fixtures
    excludePaths:
        analyse:
            - tests/PHPStan/Fixtures/*

    level: max
    paths:
        - src
        - fixtures
        - tests
        - extension-ecs.php
        - extension-rector.php
        - ecs.php
        - rector.php

    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: fixtures/*
        -
            identifier: class.notFound
            path: fixtures/*

{
    "name": "larastrict/conventions",
    "description": "LaraStrict conventions for your Laravel apps - PHPStan, Easy Coding Standard, RectorPHP and appropriate rules.",
    "type": "package",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "LaraStrict\\Conventions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraStrict\\ConventionsTests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Martin Kluska",
            "email": "martin@kluska.cz"
        }
    ],
    "require": {
        "php": ">=8.3",
        "strictphp/conventions": "^2.1",
        "larastan/larastan": "^v3.10.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.30",
        "orchestra/testbench": "^v10.10.0 | ^v11.1.0"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan",
        "qa": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "lint": [
            "@lint:upgrade",
            "@lint:fix"
        ],
        "lint:check": "./vendor/bin/ecs",
        "lint:fix": "./vendor/bin/ecs --fix",
        "lint:stan": "./vendor/bin/phpstan",
        "lint:upgrade": "vendor/bin/rector process",
        "lint:upgrade:check": "vendor/bin/rector process --dry-run"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        },
        "strictphp/conventions": {
            "skills": {
                "larastrict": "resources/ai/larastrict",
                "larastrict-cache": "resources/ai/larastrict-cache",
                "larastrict-migrations": "resources/ai/larastrict-migrations",
                "larastrict-testing": "resources/ai/larastrict-testing"
            },
            "instructions": [
                "resources/ai/AGENTS.md"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.github",
            "/.gitlab",
            "/.idea",
            "/.phpunit.cache",
            "/.gitattributes",
            "/.gitignore",
            "/CONTRIBUTING.md",
            "/composer.lock",
            "/ecs.php",
            "/fixtures",
            "/phpstan-baseline.neon",
            "/phpstan.neon",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/rector.php",
            "/tests",
            "/vendor"
        ]
    }
}
